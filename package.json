{
  "name": "carte-scolaire-ief-oussouye",
  "version": "1.1.0",
  "description": "Carte scolaire – IEF Oussouye",
  "author": "IEF Oussouye – Planification et Statistiques",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable nsis --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "sn.ief.oussouye.cartescolaire",
    "productName": "Carte scolaire IEF Oussouye",
    "files": [
      "main.js",
      "www/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Carte-scolaire-IEF-Oussouye-Installateur-${version}.exe"
    },
    "portable": {
      "artifactName": "Carte-scolaire-IEF-Oussouye-Portable-${version}.exe"
    }
  }
}
